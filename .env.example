# Optional environment variables — the editor works without any of these for local-only mode

# Google Maps API key (enables address search)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Dev server port (default: 3002)
# PORT=3002

# Dot Science ecosystem Auth (dot-science-ecosystem) — required for Google sign-in
# Put secrets in repo-root `.env.local` (symlinked to `apps/editor/.env.local` for Next/middleware).
NEXT_PUBLIC_SUPABASE_URL=https://hhroabzrhglzjlyavkeu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_DOT_SCIENCE_APP=abstra-space
DOT_SCIENCE_ENV=development
